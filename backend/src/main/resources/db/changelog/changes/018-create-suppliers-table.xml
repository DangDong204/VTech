    <changeSet id="create-inventory-receipts-table" author="dongdang">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="inventory_receipts"/>
            </not>
        </preConditions>
        <createTable tableName="inventory_receipts" remarks="Bảng phiếu nhập kho">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="receipt_code" type="VARCHAR(50)">
                <constraints nullable="false" unique="true"/>
            </column>
            <column name="supplier_id" type="VARCHAR(36)"/>
            <column name="total_amount" type="DECIMAL(15, 2)" defaultValue="0.00">
                <constraints nullable="false"/>
            </column>
            <column name="note" type="TEXT"/>
            <column name="status" type="VARCHAR(20)" defaultValue="PENDING"/>
            <column name="created_by" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="inventory_receipts" baseColumnNames="supplier_id"
                                 constraintName="fk_receipt_supplier"
                                 referencedTableName="suppliers" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="create-inventory-receipt-details-table" author="dongdang">
        <preConditions onFail="MARK_RAN">
            <not>
                <tableExists tableName="inventory_receipt_details"/>
            </not>
        </preConditions>
        <createTable tableName="inventory_receipt_details" remarks="Bảng chi tiết phiếu nhập">
            <column name="id" type="VARCHAR(36)">
                <constraints primaryKey="true" nullable="false"/>
            </column>
            <column name="receipt_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="variant_id" type="VARCHAR(36)">
                <constraints nullable="false"/>
            </column>
            <column name="quantity" type="INT">
                <constraints nullable="false"/>
            </column>
            <column name="import_price" type="DECIMAL(15, 2)">
                <constraints nullable="false"/>
            </column>
            <column name="total_price" type="DECIMAL(15, 2)">
                <constraints nullable="false"/>
            </column>
        </createTable>

        <addForeignKeyConstraint baseTableName="inventory_receipt_details" baseColumnNames="receipt_id"
                                 constraintName="fk_detail_receipt"
                                 referencedTableName="inventory_receipts" referencedColumnNames="id"
                                 onDelete="CASCADE"/>

        <addForeignKeyConstraint baseTableName="inventory_receipt_details" baseColumnNames="variant_id"
                                 constraintName="fk_detail_variant"
                                 referencedTableName="product_variants" referencedColumnNames="id"/>
    </changeSet>

    <changeSet id="add-audit-columns-to-receipt-details" author="dongdang">
        <preConditions onFail="MARK_RAN">
            <not>
                <columnExists tableName="inventory_receipt_details" columnName="created_at"/>
            </not>
        </preConditions>
        <addColumn tableName="inventory_receipt_details">
            <column name="created_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
            <column name="updated_at" type="TIMESTAMP" defaultValueComputed="CURRENT_TIMESTAMP ON UPDATE CURRENT_TIMESTAMP">
                <constraints nullable="false"/>
            </column>
        </addColumn>
    </changeSet>

</databaseChangeLog>